# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# --- Secrets / local env (NEVER commit API keys) ---
.env
.env.*
!.env.example

# --- Generated data (rebuilt deterministically by app.db.seed) ---
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
# Eval runs: publish the final per-provider reports and the pre-tuning baseline (evals/REPORT.md links to
# them); scratch and in-progress runs (latest.*, tuning runs) stay local.
backend/evals/results/*
!backend/evals/results/baseline.md
!backend/evals/results/baseline.json
!backend/evals/results/ollama/
!backend/evals/results/groq/
backend/evals/results/ollama/*
backend/evals/results/groq/*
!backend/evals/results/ollama/final.*
!backend/evals/results/groq/final.*
!backend/evals/results/ollama/dev/
!backend/evals/results/groq/dev/
backend/evals/results/ollama/dev/*
backend/evals/results/groq/dev/*
!backend/evals/results/ollama/dev/final.*
!backend/evals/results/groq/dev/final.*

# --- Node / frontend ---
node_modules/
frontend/dist/
*.tsbuildinfo

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Assignment brief (company material, keep out of the public repo) ---
FD Engineer Hiring Assignment.pdf
