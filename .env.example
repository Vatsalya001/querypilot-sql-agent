# QueryPilot configuration. `make setup` copies this file to .env; edit .env, never commit it.
#
# The backend reads .env from the repository root (and backend/.env); variables exported in your shell
# take precedence. Commented-out settings show their built-in default: uncomment a line to change it.
# Keep values unquoted and comments on their own lines, because Docker's --env-file reads values
# literally. If a key appears twice, the last occurrence wins.

# =====================================================================================================
# LLM provider: ollama (local, default) | groq | google | openai (any OpenAI-compatible API) | mock
# (offline and rule-based; used by tests and CI). To switch, comment out the Ollama block and uncomment
# another one.
# =====================================================================================================

# --- Ollama: local, free, offline, no API key (default). Set up with: make ollama -------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
# Model for the cheap steps (intent detection, explanations). Empty means LLM_MODEL; one model for
# every role means a 16 GB machine never has to swap models.
LLM_FAST_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# How long Ollama keeps the model loaded after a request (Go duration such as 30m or 1h).
OLLAMA_KEEP_ALIVE=30m
# Context window in tokens (Ollama only). Prompts include the whole schema, so keep it at 8192 or more.
LLM_NUM_CTX=8192
# Prime the local model's prompt cache at startup so the first requests are fast (Ollama only;
# /api/health reports llm.warmup = warming | ready | skipped | failed).
LLM_WARMUP=true

# --- Groq: free hosted API used by the public demo. Key: https://console.groq.com/keys ---------------
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FAST_MODEL=openai/gpt-oss-20b
# LLM_FALLBACK_MODELS=qwen/qwen3.8-27b
# GROQ_API_KEY=

# --- Google Gemini free tier. Key: https://aistudio.google.com/apikey -------------------------------
# LLM_PROVIDER=google
# LLM_MODEL=gemini-flash-latest
# LLM_FAST_MODEL=gemini-flash-lite-latest
# GOOGLE_API_KEY=

# --- Any OpenAI-compatible API: OpenAI, Cerebras, OpenRouter, LM Studio, vLLM, ... -------------------
# OPENAI_BASE_URL is empty for OpenAI itself; otherwise e.g. https://api.cerebras.ai/v1,
# https://openrouter.ai/api/v1 or http://localhost:1234/v1 (LM Studio; a local server needs no key).
# LLM_PROVIDER=openai
# LLM_MODEL=your-model-id
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# --- Shared LLM settings (every provider) -----------------------------------------------------------
# Comma-separated models of the same provider, tried in order when a call fails (for example HTTP 429).
# LLM_FALLBACK_MODELS=
# LLM_TEMPERATURE=0
# Seconds before a single LLM call is abandoned.
# LLM_TIMEOUT_S=120
# Thinking mode. Off for latency: Ollama skips thinking, Groq gpt-oss models use low reasoning effort.
# LLM_REASONING=false
# Upper bound for output tokens per LLM call.
# LLM_MAX_OUTPUT_TOKENS=1024

# =====================================================================================================
# Database and query execution
# =====================================================================================================
# SQLite file, always opened read-only. Empty means the sample database backend/data/company.db, which the
# app builds on first start (or rebuild it with `make seed`).
# DATABASE_PATH=
# Most rows returned per query; the response says truncated=true when more exist.
# MAX_RESULT_ROWS=500
# Time limit for executing one query, in seconds.
# QUERY_TIMEOUT_S=5

# =====================================================================================================
# Agent behaviour
# =====================================================================================================
# Attempts per request: the first generation plus self-corrections after failed validation.
# MAX_SQL_ATTEMPTS=3
# Longest accepted user message, in characters.
# MAX_INPUT_CHARS=2000
# Recent conversation turns given to the model for follow-up questions.
# HISTORY_WINDOW=8

# =====================================================================================================
# API server
# =====================================================================================================
# Per-client-IP limits on the chat endpoints; they protect free LLM quotas on a public deployment.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_PER_DAY=500
# Comma-separated browser origins allowed to call the API cross-origin (the Vite dev server). Empty
# means same-origin only, which is all production needs because it serves the UI and the API together
# (the Docker image defaults to empty).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Directory of the built UI. Empty means auto-detect frontend/dist (or /app/static in Docker).
# STATIC_DIR=
# DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO
